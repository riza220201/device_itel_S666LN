// VNDK 31 libraries for stock's Android-12 vendor blobs.
//
// WHY
//   itel's vendor partition was built against VNDK 31 (ro.vndk.version=31 in
//   stock's build.prop, both prop blocks). This ROM ships platform VNDK 33, and
//   some of those blobs do not survive the difference. Measured on hardware
//   2026-08-11, both crash-looping from the first seconds of boot with no
//   SELinux denial and no missing symbol:
//
//     vendor.mediatek.hardware.pq@2.2-service
//         'incStrongRequireStrong() ... which isn't already owned'
//         -- a libutils RefBase assertion, i.e. two incompatible libutils
//     android.hardware.audio.service.mediatek
//         'terminating' -- uncaught C++ exception
//
//   The audio one blocks boot: AudioPolicyService never publishes, so
//   system_server hangs in native_list_audio_product_strategies until Watchdog
//   kills it, forever.
//
// WHY NOT BOARD_VNDK_VERSION := 31
//   Tried, reverted. It fails soong analysis with 967 errors -- prebuilt vendor
//   libraries implicitly need STATIC image:vendor.31 variants of libunwind and
//   libclang_rt.builtins, which the snapshot does not carry. See the revert
//   commit for the detail.
//
// PROVENANCE
//   Copied verbatim from prebuilts/vndk/v31, which is AOSP's own VNDK snapshot
//   and already in this device's manifest. Apache-2.0, same as the rest of
//   AOSP. NOT taken from any device tree or ROM build.
//
//     lib64  from arm64/arch-arm64-armv8-a/shared/{vndk-sp,vndk-core}/
//     lib    from arm/arch-arm-armv7-a-neon/shared/{vndk-sp,vndk-core}/
//
//   They are committed here rather than referenced in place because a soong
//   module may only name files inside its own directory. 2.4 MB total.
//
// SONAMES ARE PATCHED, AND THEY MUST BE
//   Each file here has had its SONAME rewritten to match its filename:
//
//     patchelf --set-soname libutils-v31.so lib64/libutils.so   (etc, both ABIs)
//
//   Without that they still declare themselves as plain "libutils.so", and the
//   first one loaded wins the name for the WHOLE process. Measured on hardware
//   2026-08-11, build 40, after renaming only the filenames:
//
//     CANNOT LINK EXECUTABLE ".../android.hardware.audio.service.mediatek":
//       cannot locate symbol "_ZN7android8String16C1EOS0_"
//       referenced by "/vendor/lib64/libaudioclient_aidl_conversion.so"
//
//   That symbol is android::String16::String16(String16&&) -- present in v33's
//   libutils, absent from v31's. libaudioclient_aidl_conversion is built by the
//   PLATFORM, so it is v33-era and needs the v33 copy; it asked for
//   "libutils.so" and got v31, because v31 had already been loaded under that
//   soname by the service binary.
//
//   With distinct sonames the two coexist: MTK blobs whose DT_NEEDED says
//   libutils-v31.so get v31, everything else gets the platform's v33.
//
// THE RISK THIS LEAVES
//   Two libutils in one address space is exactly the condition that produces
//   incStrongRequireStrong -- the symptom this whole change exists to fix. It is
//   safe only while no android::RefBase or String16 OBJECT crosses between the
//   v31 half and the v33 half of a process. That holds for a HIDL service whose
//   MTK side talks to the platform side over binder (serialised, no shared
//   objects), and it is why this technique works in OSS-hybrid trees generally.
//
//   It does NOT hold if a renamed library passes a refcounted object directly to
//   an unrenamed one in the same process. So: rename per PROCESS, keep the
//   binary and its passthrough impl together, and if a new consumer is added,
//   check what else lives in its address space first. blob_fixup in
//   extract-files.sh patches pq@2.2-service together with both ABIs of its
//   pq@2.15-impl for exactly that reason.

cc_prebuilt_library_shared {
    name: "libutils-v31",
    stem: "libutils-v31",
    owner: "aosp",
    vendor: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["lib64/libutils.so"] },
        android_arm: { srcs: ["lib/libutils.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: false,
}

cc_prebuilt_library_shared {
    name: "libhidlbase-v31",
    stem: "libhidlbase-v31",
    owner: "aosp",
    vendor: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["lib64/libhidlbase.so"] },
        android_arm: { srcs: ["lib/libhidlbase.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: false,
}

cc_prebuilt_library_shared {
    name: "libcutils-v31",
    stem: "libcutils-v31",
    owner: "aosp",
    vendor: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["lib64/libcutils.so"] },
        android_arm: { srcs: ["lib/libcutils.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: false,
}

cc_prebuilt_library_shared {
    name: "libbinder-v31",
    stem: "libbinder-v31",
    owner: "aosp",
    vendor: true,
    strip: { none: true },
    target: {
        android_arm64: { srcs: ["lib64/libbinder.so"] },
        android_arm: { srcs: ["lib/libbinder.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: false,
}
