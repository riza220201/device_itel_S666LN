// VNDK 31 snapshot, installed into /vendor/lib{,64}/vndk for the A12 blobs.
//
// 🔴 THIS DIRECTORY CANNOT SERVE THE AIDL `-ndk_platform` MEMBERS. 2026-08-18.
//   vendor/lib*/vndk is not a search path of the namespace a vendor process
//   runs in -- vendordefault.cc:38 gives it /odm/${LIB}, /vendor/${LIB},
//   /vendor/${LIB}/hw, /vendor/${LIB}/egl and nothing more. vndk/ is reached
//   only over an ALLOWLISTED link:
//       ns.GetLink("vndk").AddSharedLib({VNDK_SAMEPROCESS_LIBRARIES_VENDOR,
//                                        VNDK_CORE_LIBRARIES_VENDOR})
//   = vndkcore.libraries.33.txt + vndksp.libraries.33.txt, which contain no
//   `_platform` soname at all. So this snapshot's reach is the INTERSECTION of
//   v31's VNDK set with v33's allowlist, and its 21 AIDL NDK libraries (VNDK in
//   v31, not VNDK in v33) fall outside it. They are still worth shipping here --
//   inside the vndk namespace the allowlist does not apply, so they satisfy
//   intra-VNDK edges such as libmemtrack.so -> memtrack-V1-ndk_platform.so.
//   They simply cannot serve a consumer in the vendor default namespace.
//
//   Those consumers are served from hardware/lineage/compat instead; see the
//   'A12 AIDL soname aliases' block in device.mk. Do NOT try to fix it by
//   dropping `relative_install_path: "vndk"` here -- the compat modules already
//   own vendor/lib{,64}/<soname>.so and the second rule is a kati parse error.
//
//   COST: build 68 hung in post-fs-data. keymint-service.trustonic could not
//   link, keystore2 never registered IKeystoreService, and init.rc:710's
//   BLOCKING `exec ... vdc keymaster earlyBootEnded` froze init's action queue.
//
// WHY
//   This vendor partition was built against VNDK 31 and its blobs abort against
//   platform VNDK 33 -- RefBase's object layout moved between A12 and A13, which
//   is the camera crash (incStrongRequireStrong, 4+ per open). Stock resolves it
//   with ro.vndk.version=31 plus com.android.vndk.v31.apex; this tree cannot set
//   that property (config.mk forces BOARD_VNDK_VERSION=current, main.mk emits
//   ro.vndk.version unconditionally, and post_process_props rejects a duplicate),
//   so the libraries are placed where the vendor namespace already looks.
//
// WHY vendor/lib*/vndk AND NOT vndk-sp
//   The [vendor] section searches vndk-sp, then vndk, then the apex. The [system]
//   section searches vndk-sp then the apex and never reads vndk/ at all. Putting
//   the COMPLETE set in vndk/ therefore gives every vendor process all-v31 and
//   leaves system processes all-v33 -- one coherent generation each, instead of
//   the mixture that killed the gralloc mapper when SP and core libs were split.
//   Measured on hardware: camerahalserver maps 139 of these, SurfaceFlinger 0.
//   vndk-sp is also unusable: soong already owns a rule for
//   vendor/lib{,64}/vndk-sp/libutils.so (a linkerconfig TEST module), and a
//   second rule for the same install path is a parse-time error.
//
// WHY MODULES AND NOT PRODUCT_COPY_FILES
//   The build rejects ELF prebuilts in PRODUCT_COPY_FILES outright:
//     "found ELF prebuilt in PRODUCT_COPY_FILES, use cc_prebuilt_binary /
//      cc_prebuilt_library_shared instead."
//   BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES would silence that, and is not
//   used here: it disables the check for the whole product, and this tree does
//   not turn gates off to make a change fit.
//
// WHY THE FILES ARE COMMITTED HERE
//   Same reason prebuilts/vndk31/Android.bp gives: a soong module may only name
//   files inside its own directory, so they cannot be referenced in place from
//   prebuilts/vndk/v31. 40 MB, Apache-2.0, copied verbatim from AOSP's own
//   snapshot -- lib64 from arm64/arch-arm64-armv8-a/shared/{vndk-sp,vndk-core},
//   lib from arm64/arch-arm-armv8-a/shared/{...}. NOT from any device tree or
//   ROM build.
//
//   🔴 The 32-bit set comes from arm64/arch-arm-armv8-a, NOT arm/arch-arm-armv7-a-neon.
//   This device is arm64-primary with an arm secondary, and the two directories
//   hold different builds: 130 of 134 differ between them.
//
// NAMES
//   Each module is <lib>-vndk31 with `stem` set back to the real soname, because
//   the platform defines most of these names itself. The install path is free
//   (soong has zero rules under vendor/lib*/vndk), so nothing collides.
//
// VALIDATED on hardware 2026-08-13 with these exact files: camera opens,
// previews, captures JPEG and records H.264 through the MTK encoder; c2, audio,
// SIM, Wi-Fi unaffected; 256 services against a 256 baseline; 0 tombstones.


cc_prebuilt_library_shared {
    name: "android.hardware.audio.common@2.0-vndk31",
    stem: "android.hardware.audio.common@2.0",
    owner: "aosp",
    vendor: true,
    strip: { none: true },
    relative_install_path: "vndk",
    target: {
        android_arm64: { srcs: ["lib64/android.hardware.audio.common@2.0.so"] },
        android_arm: { srcs: ["lib/android.hardware.audio.common@2.0.so"] },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: false,
}

