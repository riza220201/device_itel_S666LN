//
// libr54shim -- see libr54shim.c for the full reasoning. In short: Mali r54p1's
// userspace driver needs three symbols (two libged, one libgpu_aux) that this
// device's stock A12 vendor libraries do not export, and taking the A16
// libraries that own them would cascade into MediaTek's picture-quality stack.
//
// vendor: true is mandatory. libGLES_mali is loaded into every process that
// touches EGL through the VENDOR namespace, so a system-side library would be
// invisible to it.
//
// stl: "none": pure C, no STL of its own.

cc_library_shared {
    name: "libr54shim",
    vendor: true,
    stl: "none",
    srcs: ["libr54shim.c"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
