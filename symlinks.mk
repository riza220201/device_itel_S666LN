#
# MediaTek keeps most vendor libraries in a platform subdirectory
# (/vendor/lib64/mt6789/) and puts a symlink beside it at /vendor/lib64/,
# because the dynamic linker searches /vendor/lib64 and NOT the subdirectory.
# Stock ships 640 such links. Without them the libraries are installed but
# unreachable, and the failure looks like a missing library rather than a
# missing symlink.
#
# They are created here rather than in proprietary-files.txt because
# extract-utils on lineage-20.0 has no ';SYMLINK=' support -- that arrived on a
# later branch. Passing it here silently emits bogus 'certificate:' fields and
# breaks 32/64-bit module pairing, because prefix_match appends the argument to
# the path before comm -12 compares lib/ against lib64/, so the pair no longer
# matches and soong sees two modules with one name.
#
# Regenerate with tools/gen_symlinks.py after a firmware bump.

LOCAL_PATH := $(call my-dir)

define s666ln-symlink
$(eval _lnk := $$(TARGET_OUT_VENDOR)/$(1)) \
$(eval _tgt := $(2)) \
$(eval $$(_lnk): ; @mkdir -p $$(dir $$@); ln -sf $$(_tgt) $$@) \
$(eval ALL_DEFAULT_INSTALLED_MODULES += $$(_lnk))
endef

