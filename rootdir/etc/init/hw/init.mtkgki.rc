# stdio_to_kmsg: init.insmod.sh names every module that fails to load, and
# without this its stdout goes to /dev/null -- which is why build 20 could load
# 0 of 177 vendor_dlkm modules while leaving no record anywhere. init does the
# writing, so the script needs no sepolicy of its own.
service insmod_sh /vendor/bin/init.insmod.sh /vendor/etc/init.insmod.${ro.hardware}.cfg
    class main
    user root
    group root system
    disabled
    oneshot
    stdio_to_kmsg

on early-init
    setprop vendor.all.modules.ready 0
    write /proc/bootprof "modprobe: Load_Module_START"
    start insmod_sh
