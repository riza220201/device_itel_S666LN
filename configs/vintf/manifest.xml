        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ITui</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::ITui/default</fqname>
    </hal>
    <!--
        No <sepolicy><version>. Stock declares 31.0, describing the sepolicy
        ITEL's vendor was compiled against. This ROM sets BOARD_VENDOR_SEPOLICY_DIRS
        and builds its vendor sepolicy from source against the LineageOS 20
        platform, i.e. 33.0, so stock's number describes someone else's build.

        Hardcoding it here is also not merely wrong but fatal: assemble_vintf
        refuses to reconcile the two with
          Cannot override existing value 31.0 with BOARD_SEPOLICY_VERS (which is 33.0)
        Leaving it out lets assemble_vintf write whatever BOARD_SEPOLICY_VERS is,
        so this file cannot drift from the sepolicy actually being built.
    -->
    <kernel target-level="6"/>
</manifest>
