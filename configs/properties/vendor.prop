# ---------------------------------------------------------------------------
# HAL selectors. These pick which implementation each subsystem loads and
# are the single most load-bearing block in this file — ro.hardware.egl=meow
# in particular selects the MEOW EGL wrapper that fronts libGLES_mali.

ro.hardware.egl=meow
ro.hardware.gatekeeper=trustonic
ro.hardware.gralloc=common
ro.hardware.hwcomposer=mtk_common
ro.hardware.kmsetkey=trustonic
ro.hardware.paytrigger=trustonic
ro.hardware.vulkan=mali

# ---------------------------------------------------------------------------
# Mali r38p1 EGL config table. 🔴 NOT tuning, and NOT optional.
#
# The vendor tree ships Mali r38p1 (Samsung XCover7, same Mali-G57 MC2). At
# r38p1 ARM moved the per-format EGL config table OUT of the driver and into
# these properties. r32p1 had it compiled in — MediaTek built that copy for
# this platform — which is why stock sets none of these and why this tree
# never did either. Nothing in the driver swap's acceptance checks (sdk,
# revision, DT_NEEDED subset, 65 MTK symbols resolvable, no
# gpudMaliSyncEventLog) can see a config table, so this shipped.
#
# Left unset, the driver rebuilds the table from its own defaults and gets it
# wrong on this device. Measured on hardware 2026-08-27, same boot, one
# variable, against stock r32p1 staged over /vendor via meta-overlayfs:
#
#   configs advertising EGL_RECORDABLE_ANDROID   r32p1  6   r38p1 unset   0
#   configs advertising EGL_WINDOW_BIT           r32p1 21   r38p1 unset   6
#
# Zero recordable configs means eglChooseConfig returns ZERO matches for any
# camera/video GL pipeline. The app then hands an uninitialised EGLConfig to
# eglCreateContext and gets EGL_BAD_CONFIG (0x3005). WhatsApp's in-chat camera
# force-closed on exactly that; its Status camera failed one call later at
# eglCreateWindowSurface with the same 0x3005. Both reported by the operator
# on the 27/08 HOTFIX release and reproduced live.
#
# VALUES ARE MEASURED ON THIS DEVICE, not copied from a donor: each is what
# stock r32p1 reports for the same config, so these restore stock's table
# exactly — 25 of 25 configs match on SURFACE_TYPE, RECORDABLE and
# NATIVE_VISUAL_ID, and every eglChooseConfig case returns stock's count.
# Only the SYNTAX (hex hal_format, true/false flags) came from Samsung's own
# mt6789 vendor build.prop (Galaxy A17, SM-A175F) — same SoC, and its driver
# reads these same keys.
#
# 🔴 THE YUV BUCKETS ARE NOW REQUIRED, and this reversed on 2026-08-27 when the
# tree moved to r54p1. The reasoning that dropped them was correct FOR r38p1 and
# wrong for this driver, so it is recorded rather than quietly deleted:
#
#   "Deliberately NOT carried: its nv12/nv21/p010/yuv420/… buckets. Those
#    hal_format codes are ARM's PRIVATE gralloc format space (0x200+) and this
#    device's gralloc is MediaTek's, not ARM's. They are also unmeasurable here
#    — our config list is 25 RGB configs and the count never moved."
#
# Measured on hardware, the two drivers read DIFFERENT bucket sets:
#
#   r38p1   reads  7 buckets   the YUV ones are never read → inert
#   r54p1   reads 19 buckets   the YUV ones are LOAD-BEARING
#
#   r54p1 without them:  24 configs,  6 recordable, WhatsApp camera FAILS
#   r54p1 with them:     65 configs, 47 recordable, WhatsApp camera WORKS
#
# So they are no longer "unverified values copied from a donor" — they are the
# difference between a working and a broken camera on this driver, tested both
# ways on this device. The two unused RGB buckets
# (r8_g8_b8_a0_32bit_fixed, r8_g8_b8_a0_24bit_yuv_special) stay omitted: no
# config on this device reads them, under either driver.
#
# ⚠ The 8/8/8/0 configs on this device read the 24bit_fixed bucket, NOT the
# 32bit one — setting 32bit alone changed nothing, setting 24bit moved them.
# Its value is 0x2 (RGBX_8888) rather than the reference's 0x3 (RGB_888)
# because that is what stock reports AND what gralloc can actually back:
# AHardwareBuffer with VIDEO_ENCODE usage allocates for RGBX_8888 and FAILS
# for RGB_888 on this device. 0x3 would advertise a config whose buffers no
# encoder can consume.
#
# 🔴 THE LABEL MATTERS AS MUCH AS THE VALUE. Unlabelled these fall to
# vendor_default_prop, which no app domain can read, so the driver sees them
# as unset and rebuilds the broken table anyway — setting them alone fixes
# nothing, which was measured before it was reasoned. See
# sepolicy/vendor/property_contexts. And property-read refusals are
# dontaudit'd (system/sepolicy/public/domain.te:146), so this whole class
# produces NO avc record: no denial sweep here could ever have found it.
#
# hal_format values are Android HAL_PIXEL_FORMAT_* constants.
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.hal_format=0x1
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.recordable=true
ro.vendor.arm.egl.configs.r8_g8_b8_a8_32bit_fixed.framebuffer_target=true
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.hal_format=0x2
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r8_g8_b8_a0_24bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.hal_format=0x4
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r5_g6_b5_a0_16bit_fixed.framebuffer_target=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.hal_format=0x16
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.recordable=false
ro.vendor.arm.egl.configs.r16_g16_b16_a16_64bit_float.framebuffer_target=false
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.hal_format=0x2b
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.recordable=false
ro.vendor.arm.egl.configs.r10_g10_b10_a2_32bit_fixed.framebuffer_target=false

# The YUV buckets — read only by r54p1, and required by it (see above). These
# hal_format values are ARM's own internal format codes, which is why they look
# nothing like HAL_PIXEL_FORMAT_*; they come from the Samsung mt6789 vendor,
# the same SoC, and are validated here by the config count and by the camera.
ro.vendor.arm.egl.configs.nv12.hal_format=0x200
ro.vendor.arm.egl.configs.nv12.recordable=true
ro.vendor.arm.egl.configs.nv21.hal_format=0x201
ro.vendor.arm.egl.configs.nv21.recordable=true
ro.vendor.arm.egl.configs.nv16.hal_format=0x10
ro.vendor.arm.egl.configs.nv16.recordable=true
ro.vendor.arm.egl.configs.yuyv.hal_format=0x202
ro.vendor.arm.egl.configs.yuyv.recordable=true
ro.vendor.arm.egl.configs.y0l2.hal_format=0x203
ro.vendor.arm.egl.configs.y0l2.recordable=true
ro.vendor.arm.egl.configs.p010.hal_format=0x204
ro.vendor.arm.egl.configs.p010.recordable=true
ro.vendor.arm.egl.configs.p210.hal_format=0x205
ro.vendor.arm.egl.configs.p210.recordable=true
ro.vendor.arm.egl.configs.y210.hal_format=0x206
ro.vendor.arm.egl.configs.y210.recordable=true
ro.vendor.arm.egl.configs.y410.hal_format=0x207
ro.vendor.arm.egl.configs.y410.recordable=true
ro.vendor.arm.egl.configs.q410.hal_format=0x20a
ro.vendor.arm.egl.configs.q410.recordable=true
ro.vendor.arm.egl.configs.yuv420.hal_format=0x208
ro.vendor.arm.egl.configs.yuv420.recordable=true
ro.vendor.arm.egl.configs.yvu420.hal_format=0x20e
ro.vendor.arm.egl.configs.yvu420.recordable=true

