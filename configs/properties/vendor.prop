#
# /vendor/build.prop additions, wired up as TARGET_VENDOR_PROP in
# BoardConfig.mk.
#
# Derived from itel stock revision 28's /vendor/build.prop. That file is a
# concatenation of two independently generated sections — MediaTek's generic
# vendor image ("hal_mgvi_64_nfc_armv82", lines 1-190) and itel's product
# section ("S666LN-OP", lines 191-741) — so a handful of keys are declared
# TWICE with DIFFERENT values. Which one takes effect depends on the type:
#
#   * ro.*  is write-once, so the MGVI (generic) value wins.
#   * everything else is last-writer-wins, so the S666LN (product) value wins.
#
# Each such key is resolved once here, the same way stock resolves it, and
# called out at the point of use. This tree cannot reproduce the two-section
# layout, and a single file with one writer per key is what we want anyway.
#
# NOT carried over from stock:
#   * identity (ro.product.*, ro.*.build.*, fingerprints, dates) — a ROM
#     decision, set by the build recipe, not by the device tree.
#   * anything the build system owns from BoardConfig/device.mk:
#     ro.zygote, ro.vndk.version, ro.board.platform, ro.product.first_api_level,
#     ro.board.first_api_level, ro.virtual_ab.*, ro.boot.dynamic_partitions,
#     ro.crypto.volume.filenames_mode, ro.control_privapp_permissions,
#     ro.bionic.*, dalvik.vm.heap*/isa*.
#     ⚠ ro.vndk.version is on that list for a harder reason than the rest: it
#       cannot be set here even deliberately. Setting it is a BUILD FAILURE, not
#       an override — see the section immediately below.
#   * persist.sys.usb.config — stock sets "none"; the build variant decides
#     here. See the note at the top of device.mk.
#   * ro.hwui.use_vulkan, which stock sets to the empty string.
#

# ---------------------------------------------------------------------------
# VNDK: ro.vndk.version is NOT set here, and must not be.
#
# This vendor partition is Android 12 (ro.vendor.build.version.sdk=31) under an
# Android 13 system, and its A12 blobs abort against platform VNDK 33 --
# RefBase's object layout moved, which is the camera crash:
#
#   Abort: 'incStrongRequireStrong() called on 0x... which isn't already owned'
#     #03 /apex/com.android.vndk.v33/lib64/libutils.so  RefBase::incStrong...
#     #05 /vendor/lib64/mt6789/libmtkcam_device3_app.so AppStreamMgr::...
#
# Stock solves that by setting ro.vndk.version=31 and shipping the v31 apex.
# This tree CANNOT: build/make/core/config.mk:735 defaults BOARD_VNDK_VERSION to
# `current`, main.mk:224-230 then emits ro.vndk.version=$(PLATFORM_VNDK_VERSION)
# into ADDITIONAL_VENDOR_PROPERTIES unconditionally, and declaring it here too
# is not first-writer-wins -- the build refuses outright:
#
#     error: found duplicate sysprop assignments:
#     ro.vndk.version=31
#     ro.vndk.version=33
#
# (Measured: build 65. `?=` does not help either -- post_process_props DELETES
# an optional assignment when a hard one exists, so 33 would win anyway.) The
# only lever is BOARD_VNDK_VERSION := 31, which also changes what every vendor
# module compiles against and fails with 967 soong errors.
#
# ✅ It is not needed. What fixes the camera is the v31 libraries being FOUND
# first, and the [vendor] namespace searches /vendor/${LIB}/vndk ahead of the
# apex. device.mk installs the complete 134-library set there, which puts every
# VENDOR process on v31 while system processes stay on v33. The configuration
# proven on hardware ran with ro.vndk.version=33 throughout.

# ---------------------------------------------------------------------------
# Screen density. RESOLVED BY HAND, NOT INHERITED.
#
# Stock declares ro.sf.lcd_density twice: 480 in the MGVI section and 320 in
# the S666LN section. ro.* is write-once, so 480 is what stock actually
# resolves to. The panel is 720x1612 (measured off a device screenshot), and
# 720px at 480dpi is a 240dp-wide screen — below the 320dp floor Android
# expects for a phone, so 480 cannot be describing this display. The stock
# props are simply not a usable source for this value.
#
# 273 matches the panel's physical density: a 6.6" diagonal at 720x1612 is
# ~267dpi. It is also the value the shipped build was confirmed running.
#
# OPEN: confirm on hardware with `adb shell wm density` — one command, and it
# settles whether 273 or 320 is right. BoardConfig's TARGET_SCREEN_DENSITY
# must be kept equal to whatever this says.
ro.sf.lcd_density=273


