#
# /system/build.prop additions, wired up as TARGET_SYSTEM_PROP in
# BoardConfig.mk.
#
# Deliberately short. Stock's /system/build.prop carries around 130 functional
# properties, but nearly all of them configure Transsion's own HiOS system
# apps (ro.tran_appm.support, ro.smartcaller_support, ro.thub.core.support,
# ro.trancare.*, ...) or set dalvik.vm.* / pm.dexopt.* tunings that LineageOS
# sets for itself. Carrying those would mean shipping configuration for
# software that is not in this ROM. Only properties with a consumer that
# actually exists here are kept.

# RIL. 🔴 Read this before touching either value.
#
# Stock sets NEITHER of these. It ships exactly one RIL daemon and passes the
# library on the command line instead:
#
#   mtkrild.rc:  service vendor.ril-daemon-mtk
#                  /vendor/bin/hw/mtkfusionrild -l libmtk-ril.so
#
# There is no mtk-ril.so on this device or in stock -- the file is called
# libmtk-ril.so. So the value below names something that does not exist, and it
# is read by a daemon stock does not ship: AOSP's `rild`, which arrives via
# build/make/target/product/telephony_vendor.mk:22 (inherited, so
# PRODUCT_PACKAGES cannot subtract it) and which in this tree resolves to
# **Cuttlefish's emulator RIL**, device/google/cuttlefish/guest/hals/rild.
#
# 🔴 DO NOT "FIX" THIS TO libmtk-ril.so, AND DO NOT SIMPLY DELETE IT. Measured on
# hardware: with this value pointing at a missing file, the Cuttlefish rild dies
# at dlopen every 5 s and never registers anything. That failure is currently the
# only thing stopping an emulator RIL from claiming IRadio ahead of the real
# modem. Pointing it at libmtk-ril.so would run two RIL daemons against one
# modem; deleting it lets Cuttlefish's rild fall back to its own default and
# register a stub.
#
# The real fix is to stop shipping that module at all -- it needs an overrides:
# on a module we control, or a recipe-side exclusion like apply-overlays step 36
# does for the power HAL. Until then this line is load-bearing by accident, and
# the crash-loop is noise in the log rather than a fault.
#
# libargs is stock's own argument and is kept: this is also the reason
# configs/properties/*.prop exist at all, since the value contains a SPACE and
# PRODUCT_PROPERTY_OVERRIDES splits on whitespace.
vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0

# Wi-Fi interface names. wlan0 / p2p0 / ap0 match what the gen4m_6789 driver
# creates; ro.vendor.wifi.sap.interface in vendor.prop is the vendor-side half
# of the same fact.
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.tethering.interface=ap0

# MediaTek Wi-Fi feature flags.
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
mediatek.wlan.ctia=0

# Retail name for About phone. Without it the framework falls back to
# manufacturer + " " + MODEL and shows "ITEL itel S666LN", because itel's stock
# model string already contains the brand.
#
# This is a device fact, not a ROM choice, so it belongs here rather than in a
# build recipe. The value is stock's own: rev 28 product/etc/build.prop:10
# declares ro.product.product.tran.device.name.default=itel RS4 (the system and
# vendor copies of that key are both empty).
#
# It has to live in a .prop file rather than PRODUCT_*_PROPERTIES because the
# value contains a space, and entries there are whitespace-separated.
ro.product.marketname=itel RS4

# --- Bluetooth profiles ------------------------------------------------------
#
# 🔴 WITHOUT THESE, BLUETOOTH PAIRS AND THEN REFUSES TO CONNECT. Every profile
# in packages/modules/Bluetooth is gated on one of these sysprops, and an UNSET
# prop means DISABLED, not default-on:
#
#   a2dp/A2dpService.java:111    BluetoothProperties.isProfileA2dpSourceEnabled().orElse(false)
#   hfp/HeadsetService.java:152  BluetoothProperties.isProfileHfpAgEnabled().orElse(false)
#
# Measured on hardware 2026-08-26, connecting a headset:
#     W A2dpService:    getA2dpService(): service is null
#     W HeadsetService: getHeadsetService(): service is NULL
#     BondStateMachine: BOND_BONDING => BOND_BONDED      <- pairing SUCCEEDS
#     l2c_link_timeout -> hci_btsnd_hcic_disconnect      <- 4s later, dropped
# i.e. the device pairs, nothing exists to accept the profile connection, and
# L2CAP times out. The adapter itself was healthy throughout: state ON, correct
# MAC, all six BT HALs registered, and ZERO SELinux denials.
#
# 🔑 WHY WE HAD ONLY ONE. Stock carries these in its SYSTEM build.prop (14
# entries); its VENDOR build.prop carries exactly one, sap.server. Our
# extraction reads the VENDOR partition -- correctly, that is the clean-room
# source -- so we inherited the single vendor-side entry and none of the
# thirteen on system, because crDroid builds system itself. Nothing was done
# wrong in the extraction; there was simply no source for these in it.
#
# ⚠ This is why "Bluetooth works" was believed for months: every check the
# journal ever ran was ADAPTER-level (state ON, adapter MAC, HAL factories
# registered, OFF->ON toggle). None of them connected a device. BLUEPRINT
# section 8 lists "BT audio" as a criterion and it was never actually exercised
# -- the same shape as OTG (verified in recovery, never in Android) and the
# camera (registered, never captured).
#
# Values are stock's own, verbatim, from .build/work/system/system/build.prop.
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true

# --- Product identity source order -------------------------------------------
#
# Makes `system` the authority for ro.product.{name,device}, so Build.PRODUCT
# and Build.DEVICE finally agree with the fingerprint this ROM presents.
#
# The defect this fixes: lineage_S666LN.mk sets
#   PRODUCT_SYSTEM_NAME   := S666LN-OP
#   PRODUCT_SYSTEM_DEVICE := itel-S666LN
# and those two lines were effectively DEAD CODE. They write only partition
# `system` (build/make/core/sysprop.mk:39-49), while init derives the bare
# ro.product.* from the first partition in its source order that has a value
# (property_service.cpp:803-860). The default order is
#   product,odm,vendor,system_ext,system
# -- system is consulted LAST. Measured on hardware, all five partitions:
#
#   ro.product.system.device = itel-S666LN     ro.product.system.name = S666LN-OP
#   ro.product.{product,odm,vendor,system_ext}.device = S666LN
#   ro.product.{product,odm,vendor,system_ext}.name   = lineage_S666LN
#
# so `product` won and the device reported Build.DEVICE=S666LN,
# Build.PRODUCT=lineage_S666LN against a fingerprint reading
# Itel/S666LN-OP/itel-S666LN -- a free tell for anything checking consistency.
#
# ⚠ BLAST RADIUS IS EXACTLY TWO PROPERTIES. brand / model / manufacturer are
# byte-identical across all five partitions (Itel / itel S666LN / ITEL), so
# reordering can only move `device` and `name`. Verified on hardware, not
# reasoned about.
#
# ⚠ This lever fires ONLY because no build.prop declares a BARE ro.product.device
# or ro.product.name. init skips the whole source-order block for any property
# already set (property_service.cpp:838-841), which would make this a SILENT
# no-op. Confirmed absent across all six build.prop files on the device, with
# the per-partition form as the positive control (2 matches per file).
#
# The permutation is legal on both sides that validate it: init's
# RO_PRODUCT_PROPS_ALLOWED_SOURCES and releasetools'
# _RO_PRODUCT_PROPS_DEFAULT_SOURCE_ORDER_CURRENT are the same five names, and an
# unrecognised entry makes init fall back to the default order rather than fail.
#
# 🔴 THIS LINE MOVES ro.product.device, AND THAT IS WHY
# `TARGET_OTA_ASSERT_DEVICE := S666LN` EXISTS IN BoardConfig.mk. Do not ship one
# without the other. releasetools resolves ro.product.device through this SAME
# source order (common.py:536), so on its own this line rewrites the OTA
# package's pre-device to itel-S666LN and every user on an older or third-party
# recovery is locked out of the ROM.
#
# Proven before shipping, by running releasetools' own BuildInfo against the
# signed target-files of v3build8 -- three cases, seconds instead of a build:
#
#   case                      OTA pre-device   Build.DEVICE   Build.PRODUCT
#   as shipped today          S666LN           S666LN         lineage_S666LN
#   this line, WITHOUT 1a     itel-S666LN      itel-S666LN    S666LN-OP     <- lockout
#   this line, WITH 1a        S666LN           itel-S666LN    S666LN-OP     <- shipped
#
# The fingerprint is byte-identical in all three, which is the control that
# matters: the identity presented to e-KYC and Play Integrity does not move.
#
# /system/build.prop is loaded FIRST and therefore has the LOWEST precedence for
# duplicate keys (property_service.cpp:1110-1123). Safe only because nothing
# else on the device declares this key -- confirmed, not assumed.
ro.product.property_source_order=system,system_ext,product,odm,vendor
