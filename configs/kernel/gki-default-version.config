# Merged by kernel.mk (merge_config.sh) ONLY for the generic GKI fallback, i.e.
# when the kernel package carries no imported kernel (BoardConfig.mk).
#
# s666ln_defconfig is shared with the custom kernel project and names its kernel
# (-Riza-vanilla, no scm suffix). The fallback is not that kernel, so it reports
# the GKI source's own default string: gki_defconfig sets neither option, and the
# Kconfig defaults are an empty LOCALVERSION with LOCALVERSION_AUTO on (the
# source commit, -g<hash>). Neither touches a symbol CRC, and with MODVERSIONS the
# module loader ignores the release string in vermagic (kernel/module.c
# same_magic), so the vendor modules and the KMI gate are unaffected.
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=y
