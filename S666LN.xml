<?xml version="1.0" encoding="UTF-8"?>
<!--
  itel RS4 (S666LN, MT6789 / Helio G99) — local manifest for an Android 13 /
  LineageOS-20 base (crDroid 13.0 tested).

  Every project below is either the operator's own independently-authored work or
  a LineageOS-official repository. Nothing is pulled from a third-party device
  stack; that is the point of this tree.

  Each entry is justified by something the device tree actually references:

    device/itel/S666LN            the tree itself
    device/itel/S666LN-kernel     TARGET_KERNEL_PACKAGE in BoardConfig.mk
    kernel/itel/S666LN            TARGET_KERNEL_SOURCE in BoardConfig.mk
    vendor/itel/S666LN            inherited by device.mk, and BoardConfigVendor.mk
    hardware/mediatek             PRODUCT_SOONG_NAMESPACES in device.mk
    device/mediatek/sepolicy_vndr sepolicy/vendor/*.te reference types it declares
                                  (e.g. vendor_mtk_powerhal_prop)

  Deliberately NOT included: hardware/transsion. All nine Transsion HAL interface
  libraries ship as prebuilt blobs in vendor/itel/S666LN and have no unmet
  vendor.* dependencies, so no source repo is required.
-->
<manifest>

  <remote name="riza" fetch="https://github.com/riza220201" clone-depth="1" />
  <remote name="los"  fetch="https://github.com/LineageOS"  clone-depth="1" />
  <remote name="crdroidgh" fetch="https://github.com/crdroidandroid" clone-depth="1" />

  <!-- ===================================================================
       Device stack
       =================================================================== -->

  <!-- The device tree. -->
  <project path="device/itel/S666LN" name="device_itel_S666LN"
           remote="riza" revision="lineage-20.0" />

  <!-- Kernel package: dtb/, dtbo.img and the two prebuilt module sets
       (198 vendor_dlkm + 206 vendor_boot). NOT the kernel image — that is built
       from source, see below. Those modules are MediaTek prebuilts with no
       source, and they are what the KMI gate checks the built kernel against. -->
  <project path="device/itel/S666LN-kernel" name="device_itel_S666LN-kernel"
           remote="riza" revision="lineage-20.0" />

  <!-- Kernel source: Google GKI android12-5.10-lts, forked only to carry
       arch/arm64/configs/s666ln_defconfig. That defconfig is the single source
       of truth for the config and is generated by the kernel project's build.sh
       (stock config + performance + network + bore + ntsync).

       It is load-bearing: the config, not the source, is what reproduces
       module_layout = 0x7c24b32d. A kernel built from gki_defconfig compiles
       fine and boots nothing. Do not set KERNEL_LTO. -->
  <project path="kernel/itel/S666LN" name="kernel_itel_S666LN"
           remote="riza" revision="lineage-20.0" clone-depth="1" />

  <!-- Proprietary blobs, extracted from itel stock firmware revision 28
       (build 251212V1661) by the device tree's own extract-files.sh. ~1.3 GB. -->
  <project path="vendor/itel/S666LN" name="vendor_itel_S666LN"
           remote="riza" revision="lineage-20.0" />

  <!-- ===================================================================
       LineageOS-official MediaTek support.
       crDroid ships only the Qualcomm equivalents, so these are additive and
       collide with nothing in default.xml or the crDroid snippets.
       =================================================================== -->

  <project path="hardware/mediatek" name="android_hardware_mediatek"
           remote="los" revision="lineage-20" />

  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr"
           remote="los" revision="lineage-20" />

  <!-- MediaTek Wi-Fi HAL source, from crDroid's own org.
       frameworks/opt/net/wifi builds libwifi-hal unconditionally and
       whole-static-links $(LIB_WIFI_HAL), which BOARD_WLAN_DEVICE := MediaTek
       resolves to libwifi-hal-mt66xx. Nothing else in the tree provides it, so
       the build fails with "libwifi-hal ... missing libwifi-hal-mt66xx".
       This repo supplies that plus the wpa_supplicant driver lib, and is itself
       guarded by BOARD_WLAN_DEVICE == MediaTek. -->
  <project path="hardware/mediatek/wlan" name="android_hardware_mediatek_wlan"
           remote="crdroidgh" revision="13.0" />

  <!-- ===================================================================
       crDroid 13.0 branch fix — NOT device-specific.
       Drop this block on any other ROM base.

       crDroid 13.0's manifest snippet is frozen at Sep-2024 but references
       rolling shared branches that have since moved. It links the webview build
       glue as src="Android.mk", which the rolling `main` branch renamed to
       os_pickup.mk. The stale linkfile produces a broken symlink and kati fails
       with "external/chromium-webview/Android.mk: No such file or directory".
       Re-add the project with the correct linkfile, matching current LineageOS.
       =================================================================== -->

  <!-- packages/services/{Mms,Telephony}: PINS REMOVED 2026-08-24.

       Both projects used to be pinned BACKWARDS here, to the last LineageOS
       revision whose signatures matched crDroid's frozen frameworks/base:

         Mms       4c511b7d  (2022-06-07)  gave up "Verify calling user on mms
                                           downloads" + the callingUserId work
         Telephony f1e9284   (2025-01-06)  gave up "Disallow shell to change
                                           CarrierRestrictionRules" and 8 more

       Both comments ended "Drop this block once crDroid picks up the
       frameworks/base side." That has now happened: crDroid's frozen 13.0 forks
       were merged forward from live lineage-20.0 (SPL 2024-09-05 -> 2026-02-01),
       so frameworks/base now carries BOTH halves. Verified before removing:

         IMms.aidl  `in int callingUser`                      0 -> 4 occurrences
         TelephonyPermissions.isShell(int)                    absent -> present
           (telephony/common/.../TelephonyPermissions.java:813 — note the path;
            it is NOT under telephony/java/android/telephony/, and grepping the
            wrong file is how this was first mis-measured)

       🔴 These pins are only safe to leave out while the frameworks/base merge
       is present. That merge is a LOCAL commit in a repo we do not own
       (crdroidandroid/android_frameworks_base), so a plain `repo sync` will
       discard it and re-break the build. tools/spl-check.sh asserts the SPL for
       exactly this reason; run it before any build. -->

  <!-- ==================================================================
       TIER B — the six crDroid forks merged forward from live lineage-20.0,
       taking PLATFORM_SECURITY_PATCH from 2024-09-05 to 2026-02-01.

       WHY THEY ARE POINTED AT OUR OWN FORKS
       This work was done once before, on the build VM, and verified on
       hardware 2026-07-27. It was then LOST — not because it was unsaved, but
       because it was saved somewhere we do not own. The merges were proper
       commits in crdroidandroid/* checkouts; the VM died 2026-08-17, the local
       re-sync restored crDroid's frozen branches, and builds 68-73 all shipped
       a 17-month-old SPL with every other gate green.

       RESUME section 10's rule was "everything in a repo survived". The real
       rule is: work is durable only where it can be PUSHED to something we
       control. So the merges now live at riza220201/&lt;repo&gt; on branch
       13.0-rs4, and repo syncs them from there.

       Re-verify with device/itel/S666LN/tools/spl-check.sh before any build;
       it asserts the SPL string AND the presence of the patches that string
       claims, because bumping the number alone would be a lie.
       ================================================================== -->

  <remove-project name="crdroidandroid/android_build" />
  <project path="build/make" name="android_build" remote="riza"
           revision="13.0-rs4" groups="pdk">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
  </project>

  <remove-project name="crdroidandroid/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="riza"
           revision="13.0-rs4" groups="pdk-cw-fs,pdk-fs" />

  <remove-project name="crdroidandroid/android_frameworks_av" />
  <project path="frameworks/av" name="android_frameworks_av" remote="riza"
           revision="13.0-rs4" groups="pdk" />

  <remove-project name="crdroidandroid/android_frameworks_opt_telephony" />
  <project path="frameworks/opt/telephony" name="android_frameworks_opt_telephony"
           remote="riza" revision="13.0-rs4" groups="pdk" />

  <remove-project name="crdroidandroid/android_system_core" />
  <project path="system/core" name="android_system_core" remote="riza"
           revision="13.0-rs4" groups="pdk" />

  <remove-project name="crdroidandroid/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings"
           remote="riza" revision="13.0-rs4" groups="pdk-fs" />

  <remove-project name="LineageOS/android_external_chromium-webview_patches" />
  <project path="external/chromium-webview/patches"
           name="LineageOS/android_external_chromium-webview_patches"
           groups="pdk" remote="github" revision="main">
    <linkfile src="os_pickup.mk" dest="external/chromium-webview/Android.mk" />
    <linkfile src="CleanSpec.mk" dest="external/chromium-webview/CleanSpec.mk" />
    <linkfile src="README" dest="external/chromium-webview/README" />
  </project>

</manifest>
