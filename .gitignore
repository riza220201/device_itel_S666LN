# Built + generated by ../tools/build-jamesdsp.sh (see prebuilts/JamesDSP/README).
# The APK is ~37 MB and the soong glue is derived from it, so none of it belongs
# in git; the README and the script are the committed artifacts.
prebuilts/JamesDSP/JamesDSP.apk
prebuilts/JamesDSP/Android.bp

# Python bytecode from tools/ (v31-delta-check.py imports nothing, but running it
# from this directory still leaves a __pycache__ behind).
tools/__pycache__/

# Built EGL/gralloc probes. Sources are tracked; the aarch64 binaries are not --
# rebuild them with the NDK recipe in tools/egl-probe/README.
tools/egl-probe/eglprobe
tools/egl-probe/eglchoose
tools/egl-probe/ahbprobe
