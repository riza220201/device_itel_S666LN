# system_suspend reads battery info directly instead of going through the health
# HAL.
#
# It is NOT an oversight that this is a dontaudit rather than an allow: reading
# sysfs_batteryinfo files from coredomain is NEVERALLOWED
# (public/domain.te, full_treble_only) — "Platform must not have access to
# sysfs_batteryinfo, but should do it via health HAL". An allow fails the build
# outright. system_suspend works without it and the health HAL is the sanctioned
# path.
dontaudit system_suspend sysfs_batteryinfo:file r_file_perms;

# Same domain, second denial, measured on build 34 (2026-08-11): 1,344 records
# in one boot of
#
#   avc: denied { read } scontext=u:r:system_suspend:s0
#        tcontext=u:object_r:sysfs:s0 tclass=dir
#
# system_suspend walks /sys enumerating wakeup sources. It suspends correctly
# without the access, so this is silenced rather than granted -- sysfs is a very
# wide type and system_suspend already has the specific nodes it needs.
#
# 🔴 This rule lives HERE and not in sepolicy/vendor/dontaudit.te with the other
# noise, and that is not a filing preference. system_suspend is declared in
# system/sepolicy/PRIVATE, so vendor policy cannot name it: build 36 died with
#
#   device/itel/S666LN/sepolicy/vendor/dontaudit.te:20:
#     ERROR 'unknown type system_suspend'
#
# which is exactly what the README in this directory warns about. Check whether
# a type is public before writing a rule against it in vendor policy.
dontaudit system_suspend sysfs:dir r_dir_perms;
