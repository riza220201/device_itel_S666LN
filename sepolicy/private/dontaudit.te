# Root-owned helpers asking for DAC overrides they do not need.
#
# Build 71, per boot: 2 + 2 for mkswap, 2 + 2 for the boringssl self test, 1 for
# gsid. All the same shape -- a process running as root touches a file it can
# already reach, and the kernel audits the capability check that the DAC layer
# short-circuits:
#
#   avc: denied { dac_override }    for comm="mkswap" capability=1
#     scontext=u:r:toolbox:s0 tcontext=u:r:toolbox:s0 tclass=capability
#   avc: denied { dac_read_search } for comm="mkswap" capability=2
#   avc: denied { dac_override }    for comm="boringssl_self_" capability=1
#     scontext=u:r:boringssl_self_test:s0
#   avc: denied { dac_read_search } for comm="boringssl_self_" capability=2
#   avc: denied { dac_read_search } for comm="gsid" capability=2
#     scontext=u:r:gsid:s0
#
# None of them fails: mkswap creates the swapfile (persist.vendor.swapfile_enable
# is set on this device), the boringssl self test passes -- init would refuse to
# continue if it did not -- and gsid runs. Granting dac_override to work around
# file ownership is the thing AOSP neverallows for good reason, and this tree
# already refuses to do it for hal_power_default (sepolicy/vendor/dontaudit.te).
#
# 🔑 Upstream already reached this conclusion for gsid and covered only half of
# it:
#   system/sepolicy/private/gsid.te:23
#     dontaudit gsid self:global_capability_class_set dac_override;
# The record here is dac_read_search, the sibling capability, on the same domain
# for the same reason. The other two domains have no upstream rule at all.
#
# global_capability_class_set rather than `capability`, matching upstream style:
# it covers the user-namespace class too, so the rule does not need revisiting
# if one of these ever runs namespaced.
dontaudit toolbox self:global_capability_class_set { dac_override dac_read_search };
dontaudit boringssl_self_test self:global_capability_class_set { dac_override dac_read_search };
dontaudit gsid self:global_capability_class_set dac_read_search;

# --- boot 2026-08-20, build 72: the same class, three more root helpers -------
#
# Identical shape to the set above -- a process running as root touches a file it
# can already reach and the kernel audits the capability check the DAC layer
# short-circuits. None of them fails at anything.
#
#   avc: denied { dac_read_search } comm="extra_free_kbyt" scontext=u:r:extra_free_kbytes:s0
#   avc: denied { dac_override }    comm="extra_free_kbyt"
#   avc: denied { dac_read_search } comm="atrace"          scontext=u:r:atrace:s0
#   avc: denied { dac_read_search } comm="adb_root"        scontext=u:r:adbroot:s0
#   avc: denied { dac_override }    comm="adb_root"
#
# extra_free_kbytes is AOSP's init helper that writes /proc/sys/vm/extra_free_kbytes
# (system/sepolicy/private/extra_free_kbytes.te). atrace already carries upstream
# dontaudits for hwservice_manager, service_manager and binder (private/atrace.te:63-65)
# and simply has none for capabilities; this tree also silences its
# debugfs_tracing_debug write in sepolicy/vendor/atrace.te.
#
# adbroot is LineageOS's, not AOSP's -- device/lineage/sepolicy/common/private/adbroot.te,
# the `adb root` service. ⚠ It only runs when someone actually enables adb root, so
# it will never appear on a user's device; it is here because it appears in OUR
# audits and a sweep that has to explain two records every time is a sweep people
# stop reading.
#
# Both capabilities on each, deliberately: build 71 showed dac_read_search for
# wpa_supplicant, that rule was written for that one record, and build 72 returned
# dac_override from the same domain. Cover the class.
dontaudit extra_free_kbytes self:global_capability_class_set { dac_override dac_read_search };
dontaudit atrace self:global_capability_class_set { dac_override dac_read_search };
dontaudit adbroot self:global_capability_class_set { dac_override dac_read_search };

# --- boot 2026-08-24, build 74: vold's removable-media helpers ------------------
#
# FOUND BY USING OTG FOR THE FIRST TIME IN ANDROID. Android-side OTG never
# worked before (the VBUS permit flag was never written -- see
# sepolicy/vendor/file.te sysfs_otg_ctl_file), so this whole code path had never
# executed on this ROM and these denials had never been seen. Fixing OTG is what
# revealed them.
#
#   avc: denied { dac_override }    comm="blkid"      scontext=u:r:blkid_untrusted:s0
#   avc: denied { dac_read_search } comm="blkid"
#   avc: denied { dac_override }    comm="fsck.exfat" scontext=u:r:fsck_untrusted:s0
#   avc: denied { dac_read_search } comm="fsck.exfat"
#   avc: denied { dac_override }    comm="sgdisk"     scontext=u:r:sgdisk:s0
#   avc: denied { dac_read_search } comm="sgdisk"
#
# Same class as the six above: a root process touching a file it can already
# reach, and the kernel audits the capability check DAC short-circuits. NOTHING
# FAILS -- measured, not assumed: the stick mounted end to end in the same boot,
# vold created volume public:8,49 (exFAT, label FACF-5897), the FUSE daemon came
# up at /mnt/user/0/FACF-5897 and the operator browsed it. The later
# `bad_removal` is the stick being pulled without ejecting.
#
# Upstream grants sgdisk only sys_admin (public/sgdisk.te:31) and gives
# fsck_untrusted/blkid_untrusted no capability rules at all -- these domains are
# deliberately minimal because they run on UNTRUSTED removable media. Silencing
# is therefore the right instrument; granting would widen exactly the domains
# upstream keeps narrow. Their neverallows were checked first (BLUEPRINT section
# 9): public/fsck_untrusted.te:33 constrains block devices and process
# transitions, not capabilities, so this is legal as well as correct.
#
# BOTH capabilities on each, per the standing lesson: write the rule for one
# record and the sibling comes back in the next build.
dontaudit fsck_untrusted  self:global_capability_class_set { dac_override dac_read_search };
dontaudit blkid_untrusted self:global_capability_class_set { dac_override dac_read_search };
dontaudit sgdisk          self:global_capability_class_set { dac_override dac_read_search };
