# GameSpace's bypass-charging tile. GameSpace is platform-signed with
# sharedUserId=android.uid.system, so it lands in system_app (seapp_contexts)
# rather than priv_app — which matters, since priv_app.te neverallows priv_app
# setting any property at all.
#
# The node is /sys/devices/platform/charger/tran_aichg_disable_charger. Stock
# init already chmods it 0666, but nothing anywhere carried an allow rule, so
# only root could ever write it — which is why manual verification appeared to
# work from a rooted shell and the feature did not work for users.
#
# Read access is included on purpose: the tile reads the node back so its UI
# reflects real hardware state rather than a remembered value.
#
# The rule stays on system_app rather than a carved-out gamespace_app domain.
# See BLUEPRINT.md §13 — that domain reached a public release and force-closed
# GameSpace, because system_app is a TYPE, not an attribute, so a domain split
# off it inherits nothing and the missing grants produce no denial to find.
allow system_app sysfs_aichg_file:file rw_file_perms;

# Settings/Storage enumerates zram for the memory UI and then reads
# /sys/block/zram0/mm_stat. Again both: the dir search alone leaves the file
# read denied.
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file r_file_perms;
