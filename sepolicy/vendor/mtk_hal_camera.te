# Persists per-sensor calibration versions (persist.vendor.cam.param.*.version).
set_prop(mtk_hal_camera, vendor_cam_param_prop)

# camerahalserver traverses /data to reach its own storage. Only `search` is
# granted, and that is the sanctioned case rather than an oversight: the
# relevant neverallow in domain.te NEGATES its permission set
# (~{ getattr search }), so vendor domains may traverse /data while read, write
# and enumerate stay barred.
allow mtk_hal_camera system_data_file:dir search;

# ⚠ That grant does NOT cover the denial seen on build 61:
#   denied { search } name="data" tcontext=u:object_r:system_data_file:s0:c512,c768
# The target carries MLS categories and mtk_hal_camera sits at s0, so this is a
# CONSTRAINT failure, not a missing allow, and no allow rule can satisfy it
# (BLUEPRINT §9). It is left alone deliberately: the fix would be
# mlstrustedsubject on a vendor camera domain, which is a far larger grant than
# the traversal is worth, and nothing has been shown to depend on it.

# Writes its watermark store. /data/vendor/camera_watermark had no type of its
# own here — stock gives it vendor_watermark_data_file — so it resolved to
# generic vendor_data_file and the HAL was denied at start on build 61:
#   denied { write } for name="camera_watermark"
# Type declared in file.te, labelled in file_contexts.
allow mtk_hal_camera vendor_watermark_data_file:dir create_dir_perms;
allow mtk_hal_camera vendor_watermark_data_file:file create_file_perms;

# The 3A thread reads the Transsion camera sysfs node at teardown. Read-only:
# every observed access is a read, and the node is a status/config input, not
# something the HAL configures. Type in file.te, label in genfs_contexts --
# all three are needed, since a grant against a type nothing carries is dead.
allow mtk_hal_camera sysfs_tran_cam_file:file r_file_perms;

# The two flash LED brightness controls. Read AND write here, which is a
# deliberate divergence from the tran_cam grant directly above: torch_level is a
# control output the HAL SETS to fire the flash, not a status input it samples.
# Both nodes are mode 0666 on the device, and stock grants mtk_hal_camera the
# full rw set on both types. Read-only would pass a denial sweep at teardown —
# the access that was actually measured — and then fail the one thing the node
# exists for, with flash an acceptance criterion in BLUEPRINT §8. Types in
# file.te, labels in genfs_contexts; all three are needed.
allow mtk_hal_camera sysfs_torch_file:file rw_file_perms;
allow mtk_hal_camera sysfs_sub_torch_file:file rw_file_perms;

# --- the camera HAL's debug-path probe, silenced 2026-08-19 (build 71) ---
#
# 14 denials per boot, in pairs at the same millisecond, and both inodes resolve
# on the device:
#
#   avc: denied { search } name="tmp"  ino=104 tcontext=u:object_r:shell_data_file:s0
#   avc: denied { search } name="data" ino=106 tcontext=u:object_r:system_data_file:s0:c512,c768
#
#   104 = /data/local/tmp   u:object_r:shell_data_file:s0
#   106 = /data/data        u:object_r:system_data_file:s0:c512,c768
#
# camerahalserver walks both looking for something that is not there -- the
# MediaTek camera stack probes for adb-pushed tuning and debug files at startup.
# Nothing depends on finding them: the camera is fully up on build 71, 2 devices,
# with provider @2.4/@2.5/@2.6 all registered.
#
# 🔴 NEITHER OF THESE SHOULD EVER BE GRANTED, for two different reasons.
#
# /data/local/tmp is the adb-writable directory. Granting a vendor HAL a read
# path out of it means anything pushed over adb can steer the camera stack. That
# is a bad trade for a debug convenience, and it is a trade this project would be
# making on behalf of ~3,100 users who never asked for it.
#
# /data/data is an MLS failure, not a missing allow. The target carries
# categories (c512,c768) and the subject sits at s0, so no allow rule can satisfy
# it -- BLUEPRINT §9. The only fix would be mlstrustedsubject on mtk_hal_camera,
# which hands the camera HAL the right to cross every per-app category boundary
# on the device, to service a probe for a debug file.
#
# Silenced, so that a denial sweep stays readable and a REAL camera denial is
# visible when one appears.
dontaudit mtk_hal_camera shell_data_file:dir search;
dontaudit mtk_hal_camera system_data_file:dir search;
