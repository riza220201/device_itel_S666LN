# init.insmod.sh reports which kernel modules failed to load, and that report is
# the only evidence there is: a batched modprobe returns 0 whatever happens, and
# the script sets vendor.all.modules.ready afterwards regardless. Build 20
# loaded 0 of 177 vendor_dlkm modules -- mali_kbase among them, so eglInitialize
# failed and surfaceflinger aborted with "no suitable EGLConfig found" -- and
# left nothing anywhere saying so.
#
# The service carries stdio_to_kmsg (init.mtkgki.rc) so init redirects the
# script's stdout to the kernel log. init opens the fd, but the SCRIPT does the
# writing, in this domain -- so stdio_to_kmsg alone is not enough, and build 21
# lost its whole diagnostic to:
#
#   avc: denied { write } for comm="init.insmod.sh" path="/dev/kmsg_debug"
#     scontext=u:r:init_insmod_sh:s0 tcontext=u:object_r:kmsg_debug_device:s0
#     tclass=chr_file permissive=0
#
# MediaTek routes it to /dev/kmsg_debug (mtk_printk_ctrl), not /dev/kmsg, so the
# target type is kmsg_debug_device rather than the kmsg_device an AOSP device
# would need.
#
# ioctl as well as write: the shell probes the fd with TCGETS (0x5401) to decide
# whether it is a terminal, which denied cleanly but filled the log with
#
#   avc: denied { ioctl } ... ioctlcmd=0x5401 tclass=chr_file
#
# once per line. The script never reads the log back, so no read.
# getattr as well, measured 2026-08-11 (build 38): 160 records per boot of
#
#   avc: denied { getattr } for comm="modprobe" path="/dev/kmsg_debug"
#     tclass=chr_file
#
# The shell stats the fd before writing. Harmless when denied, but it is 160
# lines of noise per boot in the one log this project reads to find real faults.
allow init_insmod_sh kmsg_debug_device:chr_file { write ioctl getattr };

# modprobe raises its own scheduling priority while loading 350+ modules, and
# reads /proc/cmdline to pick up module parameters. Both denied cleanly, and
# module loading works without them -- 350 modules load on build 23b onward --
# so these are silenced, not granted. sys_nice and setsched on kernel are real
# privileges and this domain does not need them to do its job.
#
#   160  init_insmod_sh -> proc_cmdline    : file    { read }
#   160  init_insmod_sh -> kernel          : process { setsched }
#        init_insmod_sh -> self            : capability { sys_nice }
dontaudit init_insmod_sh proc_cmdline:file r_file_perms;
dontaudit init_insmod_sh kernel:process setsched;
dontaudit init_insmod_sh self:capability sys_nice;
