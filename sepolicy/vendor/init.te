# init stats /system/bin/logcat for the vendor "boot_log" service
# (/vendor/etc/init/*.rc). A vendor rc naming a SYSTEM binary is the unusual
# part; init legitimately needs getattr on any service executable it is told to
# start.
allow init logcat_exec:file getattr;

# tranfs is mounted first-stage from fstab.mt6789, so init relabels the device
# node. Nothing upstream grants this — tranfs_block_device is a type this tree
# declares (see device.te).
allow init tranfs_block_device:blk_file { read relabelto };

# file_contexts labels tranfs and logo through /dev/block/by-name/, which are
# symlinks on tmpfs, so init relabels the link as well as the device. Grants
# written for a block device cover blk_file only, and the link denial only
# appears once the by-name label is actually being used.
allow init tranfs_block_device:lnk_file relabelto;
allow init logo_block_device:lnk_file relabelto;

# init tries to ptrace the fingerprint HAL, almost certainly while collecting
# diagnostics as that process exits — the Goodix HAL is known to exit once after
# a successful enroll. SILENCED, not granted: ptrace on a HAL is real privilege,
# nothing depends on it succeeding, and init reaps the process either way.
dontaudit init hal_fingerprint_default:process ptrace;

# The write half of the genfs_contexts entry for
# /proc/sys/vm/dirty_writeback_centisecs. Labelling it proc_dirty is not enough:
# init may write proc_dirty already (system/sepolicy/public/init.te:385), but
# every command in a VENDOR rc file runs as vendor_init, and vendor_init's proc
# access is read-only -- `{ open read setattr map }` on fs_type, with no write
# anywhere (public/vendor_init.te:143).
#
# Same shape as MediaTek's own entries for the knobs it labels:
#   sepolicy_vndr/basic/non_plat/vendor_init.te:14  allow vendor_init proc_cpufreq:file w_file_perms;
allow vendor_init proc_dirty:file w_file_perms;

# The write half of the genfs_contexts entry for the OTG VBUS permit flag.
# Same shape as proc_dirty above: every command in a VENDOR rc runs as
# vendor_init, so labelling the node is not enough -- vendor_init needs the
# write. init.mt6789.usb.rc's `on boot` sets it to 1.
allow vendor_init sysfs_otg_ctl_file:file w_file_perms;

# The write half of the genfs_contexts entry for
# /proc/sys/kernel/sched_pelt_multiplier (the game-scoped PELT ramp,
# init.cgroup.rc `on property:sys.gamemode.active`). Third instance of the same
# trap in this file: labelling the node is not enough, because device.mk:1183
# copies rootdir/etc/init/hw/*.rc to $(TARGET_COPY_OUT_VENDOR)/etc/init/hw, so
# every command in it runs as vendor_init, whose proc access is read-only
# (public/vendor_init.te:143) even though init itself may write proc_sched
# (public/init.te:396). Without this the write is refused and the feature ships
# DEAD -- and silently, because a refused sysctl write is not something any
# boot or denial sweep of ours reads as a functional failure.
#
# No neverallow names proc_sched or restricts writing proc_type; checked across
# system/sepolicy before writing this (BLUEPRINT section 9).
allow vendor_init proc_sched:file w_file_perms;
