# hal_power_default asks for dac_override. That is a symptom of file ownership,
# not something to grant — AOSP neverallows it for good reason. Silence it.
dontaudit hal_power_default self:capability dac_override;

# --- boot 2026-08-11, build 34: high-volume noise, no functional impact ---
#
# These are loud but harmless, and are silenced rather than granted so a
# future denial sweep is readable. 1,344 + 496 + 66 records in one boot drowns
# out everything else -- and this project's method depends on a clean sweep
# meaning something.
#
# The health HAL and system_server poke at battery/thermal nodes the vendor
# labels generically. Both work without the access: the health HAL reports and
# the battery UI is correct on the running build.
#
# system_suspend's equivalent rule is NOT here -- see sepolicy/private/.
#
# Grant, do not dontaudit, if any of these ever turns out to gate a feature --
# but measure that first. sysfs is a very wide type to open up.
dontaudit hal_health_default sysfs:file r_file_perms;
dontaudit system_server sysfs:file r_file_perms;

# --- boot 2026-08-19, build 71 ---

# vendor_init reads the VTS gate property on a build that has no VTS.
#
#   avc: denied { read } for property=vts.native_server.on uid=0 gid=0
#     scontext=u:r:vendor_init:s0 tcontext=u:object_r:vts_status_prop:s0
#     tclass=file
#
# 4 records per boot. `vts.native_server.on` is an exact-match bool declared
# system_restricted_prop (system/sepolicy/public/property.te:99,
# private/property_contexts:1140) -- it exists so the Vendor Test Suite can flip
# native servers into test mode. A release build never sets it, and vendor_init
# is evaluating a trigger on it regardless.
#
# Reading it would return nothing even if allowed, and a restricted property is
# restricted on purpose. Silenced.
dontaudit vendor_init vts_status_prop:file read;

# wpa_supplicant asking for a DAC override it does not need. Same shape as the
# plat-side set in sepolicy/private/dontaudit.te, and the same conclusion: Wi-Fi
# and hotspot both work with this denied.
#
# 🔴 BOTH capabilities, not one. Build 71 showed dac_read_search, this rule was
# written for exactly that, and build 72 came back with dac_override from the
# same domain -- the sibling capability. A capability denial from a root process
# is a CLASS, not a record: cover the set, or it returns under the other name.
dontaudit hal_wifi_supplicant_default self:global_capability_class_set { dac_override dac_read_search };

# fsck.exfat walking sysfs to resolve the OTG device's USB topology:
#
#   avc: denied { search } comm="fsck.exfat" name="usb2" dev="sysfs"
#     scontext=u:r:fsck_untrusted:s0 tcontext=u:object_r:sysfs_usb_nonplat:s0
#
# In sepolicy/vendor/ and not private/ because sysfs_usb_nonplat is MediaTek's
# type (sepolicy_vndr/basic/non_plat/file.te:199), and vendor policy is the only
# side that may name it -- BLUEPRINT section 9.
#
# Silenced rather than granted for the same reason as the capability set in
# private/dontaudit.te: fsck_untrusted is deliberately minimal, and the exFAT
# volume mounted and was browsable in the same boot with this denied, so nothing
# depends on the access succeeding.
dontaudit fsck_untrusted sysfs_usb_nonplat:dir search;

# A CHIPONE fingerprint interface on a GOODIX unit. Nothing can ever serve it:
#
#   avc: denied { find } for
#     interface=vendor.fpsensor.hardware.fpsensorhidlsvc::IFpsensorHidlSvc
#     scontext=u:r:hal_fingerprint_default:s0
#     tcontext=u:object_r:default_android_hwservice:s0
#
# Established rather than assumed, on build 77:
#   this unit's sensor        /dev/goodix_fp   (no /dev/fpsensor, no silead, no chipone)
#   who declares it           stock's manifest_chipone.xml, a DIFFERENT sensor vendor's
#                             fragment, which arrives wholesale via DEVICE_MANIFEST_FILE
#   provider in stock         NONE -- no binary and no library anywhere in the rev 28
#                             vendor partition references fpsensorhidlsvc
#
# So this is one of the 34 declared-but-unregistered entries the merged manifest
# over-promises (build 73): itel ships one manifest across sensor variants and this
# unit is not the chipone one. Unlike the NXP pair above there is no server to
# unblock, so a LABEL would be dead weight and the honest instrument is a dontaudit
# -- which is what sepolicy/vendor/hwservice_contexts has said all along.
dontaudit hal_fingerprint_default default_android_hwservice:hwservice_manager find;
